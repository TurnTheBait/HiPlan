# Database locale predefinito. Per PostgreSQL usare:
# postgresql+asyncpg://utente:password@localhost:5432/ganttflow
DATABASE_URL=sqlite+aiosqlite:///./ganttflow.db

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# App
APP_NAME=HiPlan
DEBUG=true

# Configurazione SMTP (Invio Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@tuodominio.it
SMTP_USE_TLS=true

# AI Settings
GEMINI_API_KEY="la_tua_chiave_api_qui"
GROQ_API_KEY="la_tua_chiave_api_qui"
COHERE_API_KEY="la_tua_chiave_api_qui"
